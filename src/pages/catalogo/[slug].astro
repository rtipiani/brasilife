---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config/site';
import { ProductDetailConfigurator, QuickAddToQuoteButton } from '../../components/ProductConfigurator';
import { MachineBlueprintIllustration } from '../../components/MachineBlueprintIllustration';
import machinesData from '../../data/machines.json';

export async function getStaticPaths() {
  return machinesData.map((machine) => ({
    params: { slug: machine.slug },
    props: { machine, allMachines: machinesData },
  }));
}

const { machine, allMachines } = Astro.props;

const categoryInfo = SITE_CONFIG.categories.find(
  (c) => c.id === machine.category
);

const relatedMachines = allMachines
  .filter((m) => m.category === machine.category && m.id !== machine.id)
  .slice(0, 3);
---

<BaseLayout
  title={`${machine.name} [${machine.code}] · ${SITE_CONFIG.name}`}
  description={machine.shortDescription}
>
  <section class="pt-6 pb-12 sm:pt-8 sm:pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
      <!-- Header Banner -->
      <div class="relative overflow-hidden rounded-2xl bg-zinc-900 p-5 sm:px-7 sm:py-5 text-white border-l-8 border-orange-600 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="relative z-10">
          <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-zinc-400 mb-1.5">
            <a href="/catalogo" class="hover:text-white transition">← Catálogo de Equipos</a>
            <span>/</span>
            <span class="text-orange-400">{categoryInfo?.shortName}</span>
            <span>/</span>
            <span class="font-mono text-zinc-200">{machine.code}</span>
          </div>

          <h1 class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-wide">
            <span class="text-white">{machine.titleLine1}</span>{' '}
            <span class="text-orange-500">{machine.titleLine2}</span>
          </h1>
        </div>

        <div class="relative z-10 flex flex-wrap gap-1.5">
          {
            machine.muscleGroups.map((muscle) => (
              <span class="rounded-full bg-zinc-950/80 border border-white/15 px-3 py-1 text-xs font-medium text-orange-300">
                {muscle}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Visual Preview & Multi-Product Quote Actions -->
      <ProductDetailConfigurator
        client:load
        id={machine.id}
        code={machine.code}
        slug={machine.slug}
        name={machine.name}
        category={machine.category}
        imageType={machine.imageType}
        imageUrl={machine.imageUrl}
        fullDescription={machine.fullDescription}
        highlights={machine.highlights}
      />

      <!-- 4-Card Bento Specs -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 sm:p-5">
          <span class="text-[10px] font-medium uppercase tracking-wider text-zinc-400">
            Dimensiones
          </span>
          <p class="mt-1 font-display text-xs sm:text-base font-semibold text-zinc-900">
            {machine.specs.dimensions}
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-white p-4 sm:p-5">
          <span class="text-[10px] font-medium uppercase tracking-wider text-zinc-400">
            Peso Neto
          </span>
          <p class="mt-1 font-display text-xs sm:text-base font-semibold text-orange-600">
            {machine.specs.machineWeight}
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-white p-4 sm:p-5">
          <span class="text-[10px] font-medium uppercase tracking-wider text-zinc-400">
            Capacidad / Torre
          </span>
          <p class="mt-1 font-display text-xs sm:text-base font-semibold text-zinc-900">
            {machine.specs.weightStackOrLoad}
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-white p-4 sm:p-5">
          <span class="text-[10px] font-medium uppercase tracking-wider text-zinc-400">
            Estructura
          </span>
          <p class="mt-1 font-display text-xs sm:text-base font-semibold text-zinc-900">
            {machine.specs.frameProfile}
          </p>
        </div>
      </div>

      <!-- Related Machines in Brochure Style -->
      {
        relatedMachines.length > 0 && (
          <div class="pt-4">
            <h2 class="font-display text-lg sm:text-xl font-bold uppercase tracking-wide text-zinc-900 mb-4">
              Más equipos de <span class="text-orange-600">{categoryInfo?.shortName}</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
              {relatedMachines.map((rel) => (
                <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-200 bg-white p-4 shadow-2xs transition hover:-translate-y-1 hover:border-orange-400">
                  <a
                    href={`/catalogo/${rel.slug}`}
                    class="aspect-square w-full rounded-xl bg-white block overflow-hidden p-2"
                  >
                    <MachineBlueprintIllustration
                      imageType={rel.imageType}
                      code={rel.code}
                      imageUrl={rel.imageUrl}
                      className="h-full w-full transition group-hover:scale-105"
                    />
                  </a>
                  <div class="pt-3 border-t border-zinc-100 flex items-center justify-between gap-2">
                    <div class="min-w-0">
                      <a
                        href={`/catalogo/${rel.slug}`}
                        class="block font-display text-sm font-bold uppercase tracking-wide truncate"
                      >
                        <span class="text-zinc-800">{rel.titleLine1}</span>{' '}
                        <span class="text-orange-600">{rel.titleLine2}</span>
                      </a>
                    </div>
                    <QuickAddToQuoteButton
                      client:visible
                      id={rel.id}
                      code={rel.code}
                      slug={rel.slug}
                      name={rel.name}
                      category={rel.category}
                      imageUrl={rel.imageUrl}
                    />
                  </div>
                </article>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
