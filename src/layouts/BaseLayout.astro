---
import '../styles/global.css';
import { SITE_CONFIG } from '../config/site';
import { QuoteHeaderTrigger, QuoteDrawer } from '../components/QuoteDrawer';
import { HeaderSearch } from '../components/HeaderSearch';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE_CONFIG.name} · Catálogo de Equipos para Gimnasio`,
  description = SITE_CONFIG.description,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo-brasilife.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-100/70 text-zinc-900 antialiased selection:bg-orange-600 selection:text-white">
    <!-- Top Info Strip (Location & Direct Factory Contact) -->
    <div class="bg-orange-600 text-white px-3 py-1 text-center">
      <div class="mx-auto max-w-7xl flex flex-wrap items-center justify-center gap-x-2.5 gap-y-0.5 text-[10px] sm:text-xs font-medium tracking-wide">
        <span class="font-semibold uppercase whitespace-nowrap">Fabricantes de Equipos para Gimnasios</span>
        <span class="hidden sm:inline">•</span>
        <span class="hidden sm:inline">{SITE_CONFIG.location}</span>
        <span>•</span>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsappNumber}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 underline hover:text-zinc-100 font-semibold whitespace-nowrap"
          aria-label={`WhatsApp ${SITE_CONFIG.whatsappDisplay}`}
        >
          <svg class="h-3.5 w-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.52 3.48A11.82 11.82 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.95L0 24l6.32-1.66a11.86 11.86 0 0 0 5.74 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.42ZM12.07 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.75.98 1-3.65-.24-.38a9.85 9.85 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.89 7c0 5.45-4.44 9.89-9.89 9.89Zm5.42-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z" />
          </svg>
          <span>{SITE_CONFIG.whatsappDisplay}</span>
        </a>
      </div>
    </div>

    <!-- Sticky Multi-Tier Header (Black Brand/Search Row + White Category Menu Bar) -->
    <header class="sticky top-0 z-30 shadow-sm">
      <!-- Row 1: Black Bar with Brand Logo + Search Bar + Mi Cotización -->
      <div class="bg-zinc-950 text-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2.5 sm:py-3 sm:px-6 lg:px-8">
          <!-- Brand Logo -->
          <a href="/" class="flex items-center gap-2 sm:gap-3 group shrink-0">
            <img
              src="/logo-brasilife.png"
              alt="Brasilife Fitness"
              class="h-9 w-9 sm:h-11 sm:w-11 rounded-xl object-cover ring-1 ring-orange-500/40 bg-zinc-950 transition group-hover:scale-105"
            />
            <div class="leading-none">
              <span class="font-display text-base sm:text-xl font-bold tracking-tight text-white">
                Brasi<span class="text-orange-500">life</span>
              </span>
              <span class="block text-[9px] sm:text-[10px] font-medium uppercase tracking-widest text-zinc-400 mt-0.5">
                Fitness · Perú
              </span>
            </div>
          </a>

          <!-- Centered White Search Bar with Full-Height Orange Lupa Button (DESKTOP) -->
          <div class="hidden md:block flex-1 max-w-lg mx-4">
            <HeaderSearch client:load />
          </div>

          <!-- Right Actions -->
          <div class="flex items-center gap-2 shrink-0">
            <QuoteHeaderTrigger client:load />

            <button
              id="mobile-menu-toggle"
              type="button"
              aria-label="Abrir menú de navegación"
              aria-expanded="false"
              class="inline-flex md:hidden h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full border border-zinc-800 bg-zinc-900 text-white transition hover:bg-zinc-800 cursor-pointer"
            >
              <svg id="menu-icon-open" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
              <svg id="menu-icon-close" class="hidden h-4 w-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Full-Width Search Bar on Mobile (Below Logo/Actions) -->
        <div class="block md:hidden px-4 pb-2.5">
          <HeaderSearch client:load />
        </div>
      </div>

      <!-- Row 2: Crisp White Category Menu Bar (Desktop + Horizontally Swipeable on Mobile) -->
      <div class="border-b border-zinc-200 bg-white text-zinc-800 py-1.5 sm:py-2 shadow-2xs">
        <div class="mx-auto max-w-7xl px-3 sm:px-6 lg:px-8">
          <nav class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto no-scrollbar py-0.5 text-xs font-semibold text-zinc-700 md:justify-center">
            <a
              href="/"
              data-nav-cat="home"
              class:list={[
                'shrink-0 rounded-full px-3 sm:px-4 py-1.5 transition whitespace-nowrap',
                currentPath === '/'
                  ? 'bg-orange-600 text-white font-semibold shadow-2xs'
                  : 'hover:text-orange-600 hover:bg-orange-50',
              ]}
            >
              Inicio
            </a>
            {
              SITE_CONFIG.categories.map((cat) => (
                <a
                  href={`/catalogo?categoria=${cat.id}`}
                  data-nav-cat={cat.id}
                  class="shrink-0 rounded-full px-3 sm:px-4 py-1.5 transition hover:text-orange-600 hover:bg-orange-50 whitespace-nowrap"
                >
                  {cat.shortName}
                </a>
              ))
            }
          </nav>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation Drawer -->
      <div
        id="mobile-menu-panel"
        class="hidden md:hidden border-t border-zinc-800 bg-zinc-950 px-4 pt-3 pb-5 shadow-2xl"
      >
        <nav class="grid grid-cols-2 gap-2 text-xs font-medium">
          <a
            href="/"
            class:list={[
              'mobile-nav-link flex items-center justify-center rounded-xl py-2.5 px-4 transition',
              currentPath === '/'
                ? 'bg-orange-600 text-white font-semibold'
                : 'bg-zinc-900 text-zinc-200 hover:bg-zinc-800',
            ]}
          >
            Inicio
          </a>
          {
            SITE_CONFIG.categories.map((cat) => (
              <a
                href={`/catalogo?categoria=${cat.id}`}
                data-nav-cat={cat.id}
                class="mobile-nav-link flex items-center justify-center rounded-xl bg-zinc-900 py-2.5 px-4 text-zinc-200 hover:bg-zinc-800 hover:text-orange-400 transition"
              >
                {cat.shortName}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Brochure Styled Footer -->
    <footer class="border-t-4 border-orange-600 bg-zinc-950 text-zinc-400 pb-24 sm:pb-0">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-12 lg:gap-12 items-start">
          <!-- Column 1: Brand Identity -->
          <div class="md:col-span-4 space-y-3.5">
            <a href="/" class="inline-flex items-center gap-3 group">
              <img
                src="/logo-brasilife.png"
                alt="Brasilife Fitness"
                class="h-11 w-11 rounded-xl object-cover ring-1 ring-orange-500/40 bg-zinc-900"
              />
              <div class="leading-none">
                <span class="font-display text-xl font-bold tracking-tight text-white">
                  Brasi<span class="text-orange-500">life</span>
                </span>
                <span class="block text-[10px] font-medium uppercase tracking-widest text-zinc-400 mt-1">
                  Fitness · Perú
                </span>
              </div>
            </a>

            <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed max-w-sm">
              Fabricantes directos de máquinas y equipamiento profesional para gimnasios. Estructura de acero pesado y pintura electrostática al horno con envíos a nivel nacional.
            </p>
          </div>

          <!-- Column 2: All 5 Official Categories -->
          <div class="md:col-span-4 space-y-3.5">
            <h3 class="font-display text-xs font-bold uppercase tracking-wider text-white">
              Categorías del Catálogo
            </h3>
            <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 text-xs sm:text-sm">
              {
                SITE_CONFIG.categories.map((cat) => (
                  <li>
                    <a
                      href={`/catalogo?categoria=${cat.id}`}
                      class="inline-flex items-center gap-2 text-zinc-400 hover:text-orange-400 transition"
                    >
                      <span class="h-1.5 w-1.5 rounded-full bg-orange-600 shrink-0" />
                      <span>{cat.shortName}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Column 3: Direct Factory Contact -->
          <div class="md:col-span-4 space-y-3.5">
            <h3 class="font-display text-xs font-bold uppercase tracking-wider text-white">
              Atención Directa de Fábrica
            </h3>

            <ul class="space-y-2 text-xs sm:text-sm text-zinc-300">
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 text-orange-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                <span>{SITE_CONFIG.location}</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="h-4 w-4 text-orange-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
                <a href={`mailto:${SITE_CONFIG.salesEmail}`} class="hover:text-white transition">
                  {SITE_CONFIG.salesEmail}
                </a>
              </li>
            </ul>

            <div class="pt-1 flex flex-wrap items-center gap-2.5">
              <a
                href={`https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${encodeURIComponent('Hola Brasilife Fitness, deseo recibir el catálogo y cotización por WhatsApp.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-orange-600 px-5 py-2.5 text-xs font-semibold text-white shadow-md hover:bg-orange-500 transition whitespace-nowrap"
              >
                <svg class="h-4 w-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.52 3.48A11.82 11.82 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.95L0 24l6.32-1.66a11.86 11.86 0 0 0 5.74 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.42ZM12.07 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.75.98 1-3.65-.24-.38a9.85 9.85 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.89 7c0 5.45-4.44 9.89-9.89 9.89Zm5.42-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z" />
                </svg>
                <span>Cotizar por WhatsApp</span>
              </a>

              <a
                href={SITE_CONFIG.facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900 px-4 py-2.5 text-xs font-medium text-zinc-200 hover:border-orange-500/50 hover:text-white transition whitespace-nowrap"
              >
                <span>Facebook Oficial ↗</span>
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8 border-t border-zinc-900 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left text-[11px] text-zinc-500">
          <p>
            © {new Date().getFullYear()} <span class="text-zinc-300 font-medium">{SITE_CONFIG.name}</span> ({SITE_CONFIG.legalName}). Todos los derechos reservados.
          </p>
          <p>Envíos a Lima y Provincias · Fabricación 100% Nacional</p>
        </div>
      </div>
    </footer>

    <QuoteDrawer client:load />

    <script>
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const panel = document.getElementById('mobile-menu-panel');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      toggleBtn?.addEventListener('click', () => {
        const isHidden = panel?.classList.contains('hidden');
        if (isHidden) {
          panel?.classList.remove('hidden');
          iconOpen?.classList.add('hidden');
          iconClose?.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          panel?.classList.add('hidden');
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          panel?.classList.add('hidden');
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
        });
      });

      const params = new URLSearchParams(window.location.search);
      const activeCat = params.get('categoria');
      if (activeCat) {
        document.querySelectorAll(`[data-nav-cat="${activeCat}"]`).forEach((el) => {
          el.classList.add('bg-orange-600', 'text-white', 'font-semibold');
          el.classList.remove('hover:text-orange-600', 'hover:bg-orange-50', 'bg-zinc-900', 'text-zinc-200');
        });
      }
    </script>
  </body>
</html>
