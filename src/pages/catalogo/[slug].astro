---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config/site';
import { ProductDetailConfigurator, QuickAddToQuoteButton } from '../../components/ProductConfigurator';
import { MachineBlueprintIllustration } from '../../components/MachineBlueprintIllustration';
import machinesData from '../../data/machines.json';

export async function getStaticPaths() {
  return machinesData.map((machine) => ({
    params: { slug: machine.slug },
    props: { machine, allMachines: machinesData },
  }));
}

const { machine, allMachines } = Astro.props;

const categoryInfo = SITE_CONFIG.categories.find(
  (c) => c.id === machine.category
);

const relatedMachines = allMachines
  .filter((m) => m.category === machine.category && m.id !== machine.id)
  .slice(0, 3);
---

<BaseLayout
  title={`${machine.name} [${machine.code}] · ${SITE_CONFIG.name}`}
  description={machine.shortDescription}
>
  <section class="pt-4 pb-12 sm:pt-6 sm:pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-4 sm:space-y-6">
      <!-- Clean Minimal Breadcrumb Navigation -->
      <nav class="flex items-center gap-1.5 text-xs font-medium text-zinc-500 py-1">
        <a href="/catalogo" class="hover:text-orange-600 transition">Catálogo</a>
        <span>/</span>
        <a href={`/catalogo?categoria=${machine.category}`} class="text-zinc-600 hover:text-orange-600 transition">
          {categoryInfo?.shortName}
        </a>
        <span>/</span>
        <span class="text-zinc-900 font-semibold truncate">{machine.name}</span>
      </nav>

      <!-- Prominent Product Header (Title Visible, Clean Proportionate Typography) -->
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded bg-zinc-900 px-2.5 py-0.5 font-mono text-xs font-semibold text-white">
            {machine.code}
          </span>
          <span class="text-xs font-semibold uppercase tracking-wider text-orange-600">
            {categoryInfo?.shortName}
          </span>
          <span class="text-xs text-zinc-400 font-medium">· Fabricación Nacional</span>
        </div>

        <h1 class="font-display text-xl sm:text-2xl md:text-3xl font-bold uppercase tracking-tight">
          <span class="text-zinc-900">{machine.titleLine1}</span>{' '}
          <span class="text-orange-600">{machine.titleLine2}</span>
        </h1>

        {machine.muscleGroups && machine.muscleGroups.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-0.5">
            {machine.muscleGroups.map((muscle) => (
              <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-[11px] font-medium text-zinc-600">
                {muscle}
              </span>
            ))}
          </div>
        )}
      </div>

      <!-- Visual Preview & Multi-Product Quote Actions -->
      <ProductDetailConfigurator
        client:load
        id={machine.id}
        code={machine.code}
        slug={machine.slug}
        name={machine.name}
        category={machine.category}
        imageType={machine.imageType}
        imageUrl={machine.imageUrl}
        fullDescription={machine.fullDescription}
        highlights={machine.highlights}
      />

      <!-- Compact Technical Specifications Grid -->
      <div class="rounded-xl sm:rounded-2xl border border-zinc-200 bg-white p-3 sm:p-4 shadow-2xs">
        <h3 class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 mb-2.5 px-0.5">
          Ficha Técnica de Fabricación
        </h3>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3">
          <div class="rounded-lg bg-zinc-50 border border-zinc-100 px-3 py-2 sm:py-2.5">
            <span class="block text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
              Dimensiones
            </span>
            <p class="mt-0.5 font-display text-xs sm:text-sm font-semibold text-zinc-900 leading-snug">
              {machine.specs.dimensions}
            </p>
          </div>

          <div class="rounded-lg bg-zinc-50 border border-zinc-100 px-3 py-2 sm:py-2.5">
            <span class="block text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
              Peso Neto
            </span>
            <p class="mt-0.5 font-display text-xs sm:text-sm font-semibold text-orange-600 leading-snug">
              {machine.specs.machineWeight}
            </p>
          </div>

          <div class="rounded-lg bg-zinc-50 border border-zinc-100 px-3 py-2 sm:py-2.5">
            <span class="block text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
              Capacidad / Torre
            </span>
            <p class="mt-0.5 font-display text-xs sm:text-sm font-semibold text-zinc-900 leading-snug">
              {machine.specs.weightStackOrLoad}
            </p>
          </div>

          <div class="rounded-lg bg-zinc-50 border border-zinc-100 px-3 py-2 sm:py-2.5">
            <span class="block text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
              Estructura
            </span>
            <p class="mt-0.5 font-display text-xs sm:text-sm font-semibold text-zinc-900 leading-snug">
              {machine.specs.frameProfile}
            </p>
          </div>
        </div>
      </div>

      <!-- Related Machines Matching 'Inicio' Card Style & Vertically Stacked Buttons -->
      {
        relatedMachines.length > 0 && (
          <div class="pt-4">
            <h2 class="font-display text-base sm:text-lg font-bold uppercase tracking-wide text-zinc-900 mb-4">
              Más equipos de <span class="text-orange-600">{categoryInfo?.shortName}</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
              {relatedMachines.map((rel) => (
                <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-200 bg-white p-4 shadow-xs transition duration-300 hover:-translate-y-1 hover:border-orange-500 hover:shadow-lg">
                  {/* Machine Studio Photo */}
                  <a
                    href={`/catalogo/${rel.slug}`}
                    class="relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-xl bg-white p-3"
                  >
                    <MachineBlueprintIllustration
                      imageType={rel.imageType}
                      code={rel.code}
                      imageUrl={rel.imageUrl}
                      className="h-full w-full transition duration-300 group-hover:scale-105"
                    />
                    <span class="absolute top-2.5 right-2.5 rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-[10px] font-medium text-zinc-600">
                      {rel.code}
                    </span>
                  </a>

                  {/* Two-Tone Title + Description + Stacked Buttons */}
                  <div class="flex flex-1 flex-col justify-between border-t border-zinc-100 bg-white pt-3.5">
                    <div class="text-center px-1">
                      <a
                        href={`/catalogo/${rel.slug}`}
                        class="inline-block font-display text-sm sm:text-base font-bold uppercase tracking-wide leading-snug hover:opacity-85 transition"
                      >
                        <span class="text-zinc-800">{rel.titleLine1}</span>{' '}
                        <span class="text-orange-600">{rel.titleLine2}</span>
                      </a>
                      <p class="mt-1.5 text-xs font-normal text-zinc-500 line-clamp-2 leading-relaxed">
                        {rel.shortDescription}
                      </p>
                    </div>

                    <div class="mt-3.5 pt-3 border-t border-zinc-100 flex flex-col gap-2 w-full">
                      <a
                        href={`/catalogo/${rel.slug}`}
                        class="w-full inline-flex items-center justify-center rounded-full border border-zinc-200 bg-zinc-50 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-zinc-800 hover:border-orange-500 hover:text-orange-600 transition text-center"
                      >
                        Ver Ficha →
                      </a>
                      <QuickAddToQuoteButton
                        client:visible
                        id={rel.id}
                        code={rel.code}
                        slug={rel.slug}
                        name={rel.name}
                        category={rel.category}
                        imageUrl={rel.imageUrl}
                        className="w-full"
                      />
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
